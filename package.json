{
  "name": "myolgame",
  "version": "0.1.0",
  "private": true,
  "description": "MYolGame：模板驱动的 2D 网页小游戏创作与游玩社区（初版）",
  "type": "module",
  "scripts": {
    "dev": "node dev/run-dev.ts",
    "dev:agent": "MYOLGAME_AGENT_PROVIDER=qoder node dev/run-dev.ts",
    "dev:api": "node dev/local-server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.check.json && npm --prefix web run typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:cloud": "npm run typecheck && npm run build && node dev/check-cloud.ts",
    "worker:m0": "node dev/m0-worker.ts",
    "package:cloud": "npm run check:cloud && node dev/package-cloud.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.2"
  }
}
