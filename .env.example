# 以下仅为配置示例；启动命令不会自动加载此文件，请在 shell / PowerShell 显式导出所需变量。
# 游戏开发模型三选一：qoder（本地 CLI）、http（自定义网关）、openai（OpenAI 兼容聊天接口）。
MYOLGAME_AGENT_PROVIDER=qoder
MYOLGAME_AGENT_COMMAND=qoderclicn
MYOLGAME_AGENT_NAME=Qoder CLI
MYOLGAME_AGENT_TIMEOUT_MS=180000
MYOLGAME_AGENT_REQUEST_TIMEOUT_MS=120000
MYOLGAME_AGENT_MAX_ATTEMPTS=3
# 可改为修复轮数（0–3）；设置后覆盖 MAX_ATTEMPTS，总尝试数 = 修复次数 + 1。
# MYOLGAME_AGENT_MAX_REPAIRS=2
# 从零生成首次需整页输出，建议至少 16384；修改片段模式用量只与改动大小相关。
MYOLGAME_AGENT_MAX_OUTPUT_TOKENS=16384
MYOLGAME_AGENT_MAX_RESPONSE_BYTES=1048576
# 留空则由程序按平台查找 Chrome/Edge；Windows 示例：C:\Program Files\Google\Chrome\Application\chrome.exe
MYOLGAME_CHROME_PATH=/usr/bin/google-chrome

# 自定义 HTTP 网关：服务端只发送 prompt/response_format，并读取 {"html":"..."}。
# MYOLGAME_AGENT_PROVIDER=http
# MYOLGAME_AGENT_API_URL=https://your-agent.example/generate-html
# MYOLGAME_AGENT_API_KEY=

# OpenAI 兼容游戏开发模型：模型只返回 JSON 修改片段，由服务端按唯一锚点应用并校验。
# 只设置 provider 即可启动；登录后可在「账号管理」为每个账号保存地址、密钥与模型名。
# 下面的 URL/KEY/MODEL 是可选的服务端默认值，账号配置优先于它们。
# 地址可填基址、/v1 基址或完整 /chat/completions 地址（如 https://api.deepseek.com）。
# 密钥只保存在服务端，不进入前端、日志、Git、导出源码或错误响应。
# MYOLGAME_AGENT_PROVIDER=openai
# MYOLGAME_AGENT_API_URL=https://api.example.com/v1
# MYOLGAME_AGENT_API_KEY=
# MYOLGAME_AGENT_MODEL=your-model-name
# 本机调试模型服务时才显式放行回环 HTTP（账号配置也受此限制）；默认拒绝 http。
# MYOLGAME_AGENT_ALLOW_LOCAL=1

# AI 编曲模型（OpenAI 兼容）：与游戏开发模型分开配置，只返回受限风格参数。
# 地址可填基址、/v1 基址或完整 /chat/completions 地址。
MYOLGAME_MUSIC_STYLE_API_URL=
MYOLGAME_MUSIC_STYLE_API_KEY=
MYOLGAME_MUSIC_STYLE_MODEL=

# 云端 M0：通过 Qoder 站点设置配置；不写入前端环境，也不要在聊天中发送密钥值。
# APP_ORIGIN=https://your-site.example
# APP_M0_WORKER_KEY=通过安全配置提供至少32位随机值
# 独立云端调度进程使用相同环境，执行 npm run worker:m0。

# Cloud Agents 实验：独立测试站点以服务端固定配置启用；原线上版本不自动启用。
# APP_QCA_EXPERIMENT_ENABLED=true
# APP_QCA_MODEL=从目标账号模型列表中选择的固定ID
# QODER_PAT 由平台自动托管，不在本文件配置、不上传、不输出。
